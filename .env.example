# ─────────────────────────────────────────────
# TradeBase — Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://tradebase:changeme@localhost:5432/tradebase"
POSTGRES_USER=tradebase
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tradebase

# Auth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# AI Assessment (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."

# Twilio — Inbound SMS / Call management
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+18005551000"

# Google Maps — Location verification & scheduling
GOOGLE_MAPS_API_KEY="AIza..."

# Property Records (optional — ATTOM Data or Regrid)
ATTOM_API_KEY=""
REGRID_API_KEY=""

# File uploads (choose one)
# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"

# OR Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (optional — for sending invoices)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@tradebase.co"
